# Copiar a sitio/.env, nunca a public/. UTF-8; un valor por línea.
# Se admiten comillas simples o dobles. No hay interpolación de variables.
APP_ENV=local
SITE_URL=https://aidex.com.mx
# Desactivar indexación en entornos de revisión; activar al publicar.
SITE_INDEXABLE=false
# Contacto visible opcional. Vacío = no se publica una dirección inventada.
CONTACT_EMAIL=
# URL https del aviso definitivo. Vacío = no se muestra enlace.
PRIVACY_URL=

# Activar después de configurar y probar el servidor de correo.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# tls = STARTTLS (normalmente 587); ssl = TLS implícito (normalmente 465).
# none solo está permitido en APP_ENV=local para un receptor de pruebas local.
SMTP_ENCRYPTION=tls
SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="AIDEX · Sitio web"
SMTP_TO_EMAIL=
# Vacío = responder al visitante. Configurarlo fuerza una dirección fija.
SMTP_REPLY_TO=
SMTP_TIMEOUT=15

# Límite compartido por IP: 5 intentos válidos por 15 minutos.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=900
# Opcional : ruta ABSOLUTA de almacenamiento privado (fuera de public/).
# Si se omite esta variable, se utiliza sitio/storage/.
# STORAGE_PATH=/var/lib/aidex-landing
